{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "verify-tests": {
      "extends": "development-simulator",
      "env": {
        "VIDEOSHRINK_VERIFY_TESTS": "1"
      }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6813894354"
      }
    }
  }
}
